---
// Rekentool voor woningbouwprojecten: keuze uit woningstaffels, financiële indicatie en tijdwinst naast elkaar.
// Staffels, bedragen en aannames: src/data/staffel.json. Tijdwinst: src/data/tijdwinst.json.
// De keuze en uitkomst blijven in de browser; er wordt niets verstuurd of opgeslagen.
import { site, mail, telHref } from "../data/site";
import staffel from "../data/staffel.json";
import tijdwinst from "../data/tijdwinst.json";

type Staffel = { id: string; label: string; van: number; tot: number | null; bedragVan: number | null; bedragTot: number | null };
const staffels = staffel.staffels as Staffel[];
const nl = new Intl.NumberFormat("nl-NL");
const toon = (s: Staffel) => staffel.toonBedragen && s.bedragVan !== null && s.bedragTot !== null;
const bereik = (s: Staffel) => (s.bedragVan === s.bedragTot ? `€ ${nl.format(s.bedragVan!)}` : `€ ${nl.format(s.bedragVan!)} – ${nl.format(s.bedragTot!)}`);
const woningen = (s: Staffel) => `${s.label} woningen`;
const tijdTekst = `${tijdwinst.gemiddeldOnderbouwd ? "gemiddeld" : "circa"} ${tijdwinst.zin.replace(/^(circa|gemiddeld)\s+/, "")}`;

const mailBody = (s: Staffel) =>
  "Beste Versnellingscoach,\n\nIk wil graag de mogelijke besparing voor ons woningbouwproject bespreken.\n\n" +
  `Aantal woningen: ${woningen(s)}\n` +
  (toon(s) ? `Indicatieve ${staffel.soort}besparing volgens de rekentool: ${bereik(s)}\n` : "Indicatieve besparing: graag in overleg\n") +
  `Tijdwinst uit de praktijk: ${tijdTekst}\n\nOrganisatie:\nProject en gemeente:\nProjectfase:\nTelefoonnummer:\n`;

// Alleen wat de browser nodig heeft, zonder interne toelichting.
const rekendata = JSON.stringify({
  staffels: staffels.map((s) => ({ id: s.id, woningen: woningen(s), bedrag: toon(s) ? bereik(s) : null, mail: mail("Bespreek de besparing voor ons project", mailBody(s)) })),
});
const eerste = staffels.find((s) => s.id === staffel.standaard) ?? staffels[0];
---
<section class="band" id="rekentool" aria-labelledby="rekentool-titel">
  <div class="wrap stack-lg">
    <div class="stack measure">
      <p class="eyebrow">Rekentool woningbouwprojecten</p>
      <h2 id="rekentool-titel">Wat levert versnellen uw woningbouwproject op, in geld én tijd?</h2>
      <p>Kies hoeveel woningen uw project telt en zie direct een indicatie van de besparing, met daarnaast de tijdwinst die we in eerdere trajecten zagen.</p>
    </div>
    <div class="calc" data-calc data-staffel={rekendata}>
      <div class="calc-in">
        <fieldset class="field segment staffels">
          <legend>Aantal woningen in uw project</legend>
          <div class="segment-opties">
            {staffels.map((s) => (
              <label class="segment-optie">
                <input type="radio" name="staffel" value={s.id} checked={s.id === eerste.id} />
                <span><b>{s.label}</b> woningen</span>
              </label>
            ))}
          </div>
        </fieldset>
        <p class="hint privacy-hint">Uw keuze blijft in uw browser. Er wordt niets verstuurd of opgeslagen.</p>
      </div>
      <div class="calc-out" aria-live="polite">
        <div class="uitkomsten">
          <div class="uitkomst">
            <p class="uitkomst-label">Financiële indicatie</p>
            <p class="uitkomst-waarde bereik num" data-calc-out hidden={!toon(eerste)}>{toon(eerste) ? bereik(eerste) : ""}</p>
            <p class="uitkomst-contact" data-calc-geen hidden={toon(eerste)}><a href={mail("Bespreek de besparing voor ons project", mailBody(eerste))} data-calc-geen-link>Bespreek de besparing voor uw project</a></p>
            <p class="uitkomst-sub">{staffel.soort}, per project, bij <span data-calc-woningen>{woningen(eerste)}</span></p>
          </div>
          <div class="uitkomst">
            <p class="uitkomst-label">Tijdwinst</p>
            <p class="uitkomst-waarde num">{tijdwinst.waarde.replace(/^circa/, tijdwinst.gemiddeldOnderbouwd ? "gemiddeld" : "circa")}</p>
            <p class="uitkomst-sub">{tijdwinst.bron}</p>
          </div>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" data-calc-mail href={mail("Bespreek de besparing voor ons project", mailBody(eerste))}>Bespreek deze uitkomst</a>
          <a class="btn btn-secondary" href={telHref}>Bel {site.phone.display}</a>
        </div>
        <ul class="aannames">
          {staffel.aannames.map((a) => <li>{a}</li>)}
          <li>Voor wie de besparing geldt: {staffel.voorWie ?? <span class="ph-inline">nog aan te leveren</span>}</li>
          <li>De tijdwinst is {tijdTekst} en gebaseerd op {tijdwinst.bron}. Deze staat los van de financiële indicatie.{tijdwinst.fase && <> Het gaat om tijdwinst in {tijdwinst.fase}.</>}</li>
        </ul>
        <noscript><p class="small">Zonder JavaScript ziet u de indicatie voor {woningen(eerste)}. Bel of mail ons voor een inschatting van uw project.</p></noscript>
      </div>
    </div>
  </div>
</section>

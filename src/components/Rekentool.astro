---
import { site, mail, telHref } from "../data/site";
import staffel from "../data/staffel.json";
import tijdwinst from "../data/tijdwinst.json";
// Alleen de rekendata gaat naar de browser, zonder interne toelichting.
const rekendata = JSON.stringify({ prijsGrenzen: staffel.prijsGrenzen, rijen: staffel.rijen, trajecten: tijdwinst.trajecten });
const [eerste] = tijdwinst.trajecten;
---
<section class="band" id="rekentool" aria-labelledby="rekentool-titel">
  <div class="wrap stack-lg">
    <div class="stack measure">
      <p class="eyebrow">Uw winst in 10 seconden</p>
      <h2 id="rekentool-titel">Wat levert versnellen uw project op, in geld én tijd?</h2>
      <p>Vul twee getallen in, kies uw traject en zie direct een indicatie van uw besparing en tijdwinst.</p>
    </div>
    <div class="calc" data-calc data-staffel={rekendata} data-email={site.email}>
      <div class="calc-in">
        <div class="field">
          <label for="aantal-woningen">Aantal woningen</label>
          <div class="input-wrap"><input id="aantal-woningen" name="woningen" inputmode="numeric" autocomplete="off" value="120" aria-describedby="hint-woningen fout-woningen"></div>
          <p class="hint" id="hint-woningen">Het totaal aantal woningen in uw plan.</p>
          <p class="err" id="fout-woningen" hidden></p>
        </div>
        <div class="field">
          <label for="verkoopprijs">Gemiddelde verkoopprijs per woning</label>
          <div class="input-wrap"><span aria-hidden="true">€</span><input id="verkoopprijs" name="prijs" inputmode="numeric" autocomplete="off" value="420.000" aria-describedby="hint-prijs fout-prijs"></div>
          <p class="hint" id="hint-prijs">Een schatting is voldoende.</p>
          <p class="err" id="fout-prijs" hidden></p>
        </div>
        <fieldset class="field segment">
          <legend>Traject</legend>
          <div class="segment-opties">
            {tijdwinst.trajecten.map((t, i) => (
              <label class="segment-optie">
                <input type="radio" name="traject" value={String(t.dagen)} checked={i === 0} />
                <span><b>{t.dagen} dagen</b> {t.resultaat}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <p class="hint privacy-hint">Uw cijfers blijven in uw browser. Er wordt niets verstuurd of opgeslagen.</p>
      </div>
      <div class="calc-out" aria-live="polite">
        <div class="uitkomsten">
          <div class="uitkomst">
            <p class="uitkomst-label">Kostenbesparing</p>
            <p class="uitkomst-waarde num" data-calc-out>€ 32.500</p>
            <p class="uitkomst-sub">indicatief, per project</p>
          </div>
          <div class="uitkomst">
            <p class="uitkomst-label">Tijdwinst</p>
            <p class="uitkomst-waarde num" data-calc-tijd>{eerste.tijdwinst}</p>
            <p class="uitkomst-sub">minder voorbereiding</p>
          </div>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" data-calc-mail href={mail("Bespreek mijn project")}>Bespreek deze uitkomst</a>
          <a class="btn btn-secondary" href={telHref}>Bel {site.phone.display}</a>
        </div>
        <p class="bron">Indicatief. Elk project is anders, dus ook de besparing en tijdwinst. Voorbeeld: Rucphen Noordwest pakte de planontwikkeling aan in 2 × 100 dagen, waar 4 jaar gebruikelijk is.</p>
        <noscript><p class="small">Zet JavaScript aan voor een directe indicatie, of bel ons voor een inschatting van uw project.</p></noscript>
      </div>
    </div>
  </div>
</section>

---
import { Picture } from "astro:assets";
import { site, telHref, kennismaking } from "../data/site";
import wijk from "../assets/sfeer/nieuwe-wijk.jpg";
interface Props { title?: string; text?: string }
const {
  title = "Zit uw woningbouwproject vast? Laten we het vlottrekken.",
  text = "In een kort gesprek kijken we waar uw project staat en wat 100 of 200 dagen voor u kunnen opleveren.",
} = Astro.props;
---
<section class="cta-band" aria-labelledby="cta-titel">
  <Picture class="cta-bg" src={wijk} alt="" widths={[768, 1280, 1672]} sizes="100vw" formats={["avif", "webp"]} loading="lazy" />
  <div class="wrap cta-inner">
    <div class="stack">
      <h2 id="cta-titel">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary btn-lg" href={kennismaking}>Plan een kennismaking</a>
      <a class="btn btn-ghost btn-lg" href={telHref}>Bel direct: {site.phone.display}</a>
    </div>
  </div>
</section>

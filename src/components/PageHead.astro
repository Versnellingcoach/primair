---
interface Props { crumb: string; h1: string; lead?: string }
const { crumb, h1, lead } = Astro.props;
---
<section class="page-head">
  <div class="wrap stack">
    <nav class="crumbs" aria-label="Kruimelpad"><a href="/">Home</a> <span aria-hidden="true">/</span> <span aria-current="page">{crumb}</span></nav>
    <h1>{h1}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

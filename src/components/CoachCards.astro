---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { coaches } from "../data/site";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/coaches/*.jpg", { eager: true });
const coachImage = (slug: string) => {
  const img = images[`../assets/coaches/${slug}.jpg`];
  if (!img) throw new Error(`Portret ontbreekt: src/assets/coaches/${slug}.jpg`);
  return img.default;
};
---
<div class="team-grid">
  {coaches.map((c) => (
    <a class="coach-kaart" href={`/team/${c.slug}`}>
      <Picture class="coach-foto" src={coachImage(c.slug)} alt={c.alt} widths={[360, 560, 800]} sizes="(max-width: 700px) 92vw, 360px" formats={["avif", "webp"]} loading="lazy" />
      <span class="coach-info">
        <strong>{c.name}</strong>
        <span class="role">{c.role}</span>
        <span class="link-cta">Lees over {c.name}</span>
      </span>
    </a>
  ))}
</div>

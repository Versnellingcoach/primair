---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { coaches } from "../data/site";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/coaches/*.jpg", { eager: true });
const imageFor = (slug: string) => {
  const img = images[`../assets/coaches/${slug}.jpg`];
  if (!img) throw new Error(`Portret ontbreekt: src/assets/coaches/${slug}.jpg`);
  return img.default;
};
---
<div class="team">
  {coaches.map((c) => (
    <article class="coach">
      <Picture class="avatar" src={imageFor(c.slug)} alt={c.alt} widths={[160, 320]} sizes="160px" formats={["avif", "webp"]} loading="lazy" />
      <div class="stack-xs">
        <h3>{c.name}</h3>
        <p class="role">{c.role}</p>
        {c.experience && <p class="small">{c.experience}</p>}
      </div>
    </article>
  ))}
</div>

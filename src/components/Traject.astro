---
// Eén product, twee trajectlengtes: tijdlijn van 0 tot 200 dagen.
---
<figure class="traject" aria-labelledby="traject-titel">
  <svg viewBox="0 0 640 210" role="img" aria-labelledby="traject-titel traject-desc">
    <title id="traject-titel">Het traject van de Versnellingscoach</title>
    <desc id="traject-desc">Na 100 dagen ligt er een gebiedsperspectief. Wie doorloopt tot 200 dagen, heeft een gedragen ontwikkelvisie, klaar voor bestuurlijke besluitvorming.</desc>
    <rect x="24" y="92" width="592" height="10" rx="5" fill="#E6EAF0"/>
    <rect x="24" y="92" width="296" height="10" rx="5" fill="#FF7F11"/>
    <rect x="320" y="92" width="296" height="10" rx="5" fill="#002D66"/>
    <g font-family="Lato, Arial, sans-serif" font-weight="700">
      <circle cx="30" cy="97" r="14" fill="#FFFFFF" stroke="#002D66" stroke-width="4"/>
      <text x="24" y="60" fill="#4A5874" font-size="15">START</text>
      <text x="24" y="140" fill="#14233F" font-size="16">Iedereen aan tafel</text>
      <text x="24" y="162" fill="#4A5874" font-size="14" font-weight="400">knelpunten in beeld</text>
      <circle cx="320" cy="97" r="18" fill="#FF7F11" stroke="#FFFFFF" stroke-width="4"/>
      <text x="320" y="60" fill="#002D66" font-size="22" text-anchor="middle">100 dagen</text>
      <text x="320" y="140" fill="#14233F" font-size="16" text-anchor="middle">Gebiedsperspectief</text>
      <text x="320" y="162" fill="#4A5874" font-size="14" font-weight="400" text-anchor="middle">haalbaarheid getoetst</text>
      <circle cx="610" cy="97" r="18" fill="#002D66" stroke="#FFFFFF" stroke-width="4"/>
      <text x="616" y="60" fill="#002D66" font-size="22" text-anchor="end">200 dagen</text>
      <text x="616" y="140" fill="#14233F" font-size="16" text-anchor="end">Ontwikkelvisie</text>
      <text x="616" y="162" fill="#4A5874" font-size="14" font-weight="400" text-anchor="end">klaar voor besluitvorming</text>
    </g>
  </svg>
</figure>

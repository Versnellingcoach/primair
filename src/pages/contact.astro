---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import ContactLines from "../components/ContactLines.astro";
import { site, mail, kennismaking } from "../data/site";
---
<Base title="Contact" crumb="Contact" description={`Neem contact op voor uw project, uw organisatie of uw team. Bel ${site.phone.display} of mail ${site.email}.`}>
  <PageHead crumb="Contact" h1="Start de versnelling" lead="Bel direct of mail kort waar u staat: met uw project, uw organisatie of uw team. Dan plannen we een kennismaking." />
  <section class="band" aria-label="Contactgegevens">
    <div class="wrap grid-2">
      <ContactLines />
      <div class="stack">
        <h2 class="h-card">Kies uw onderwerp</h2>
        <p class="muted">Elke knop opent een e-mail met een passend onderwerp.</p>
        <div class="stack-s">
          <a class="btn btn-primary" href={kennismaking}>Mail ons voor een kennismaking</a>
          <a class="btn btn-secondary" href={mail("Project versnellen: welk traject past?")}>Een project versnellen: 100 of 200 dagen?</a>
          <a class="btn btn-secondary" href={mail("Organisatie versterken")}>Onze organisatie versterken</a>
          <a class="btn btn-secondary" href={mail("Mogelijkheden opleiden en trainen")}>Opleiden en trainen voor ons team</a>
          <a class="btn btn-secondary" href={mail("Subsidie en ondersteuning")}>Subsidie en ondersteuning</a>
          <a class="btn btn-secondary" href={mail("Versnelling van een andere ruimtelijke opgave")}>Een andere ruimtelijke opgave</a>
        </div>
      </div>
    </div>
  </section>
</Base>

---
// Verhuisd naar /aanbod/opleiden-en-trainen. Op Vercel stuurt vercel.json met een 301 door;
// deze pagina vangt de demo en oude links op en houdt #ankers (zoals #inhousetraining) intact.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
const naar = "/aanbod/opleiden-en-trainen";
---
<Base title="Trainingen zijn verhuisd" noindex redirect={naar}
  description="Trainingen staan nu onder Aanbod, bij Opleiden en trainen. U wordt automatisch doorgestuurd naar de nieuwe pagina.">
  <PageHead crumb="Trainingen" h1="Deze pagina is verhuisd" lead="Trainingen vindt u nu onder Aanbod, bij Opleiden en trainen." />
  <section class="band">
    <div class="wrap btn-row">
      <a class="btn btn-primary" href={naar}>Naar Opleiden en trainen</a>
      <a class="btn btn-secondary" href="/aanbod">Bekijk het hele aanbod</a>
    </div>
  </section>
</Base>

---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import CoachCards from "../components/CoachCards.astro";
import TelButton from "../components/TelButton.astro";
import { site, coaches, mail, orgId } from "../data/site";
const schema = coaches.map((c) => ({ "@type": "Person", name: c.name, jobTitle: c.role, worksFor: { "@id": orgId } }));
---
<Base title="Onze coaches" crumb="Coaches" schema={schema}
  description="Maak kennis met de Versnellingscoaches. Zij werken onafhankelijk tussen gemeente, ontwikkelaar en woningcorporatie. Bel of mail voor een gesprek.">
  <PageHead crumb="Coaches" h1="Spreek een coach" lead="Onze coaches werken onafhankelijk tussen gemeente, ontwikkelaar en woningcorporatie. Bel of mail, dan bespreken we uw project." />
  <section class="band" aria-label="Coaches">
    <div class="wrap stack-lg">
      <CoachCards />
      <div class="btn-row">
        <TelButton />
        <a class="btn btn-secondary" href={mail("Kennismaking met een Versnellingscoach")}>Mail ons</a>
      </div>
    </div>
  </section>
</Base>

---
// Verhuisd naar /aanbod/projecten-versnellen. Op Vercel stuurt vercel.json met een 301 door;
// deze pagina vangt de demo en oude links op en houdt #ankers (zoals #breder en #100-dagen) intact.
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
const naar = "/aanbod/projecten-versnellen";
---
<Base title="De aanpak is verhuisd" noindex redirect={naar}
  description="De pagina over de aanpak in 100 of 200 dagen staat nu onder Aanbod, bij Projecten versnellen. U wordt automatisch doorgestuurd.">
  <PageHead crumb="Aanpak" h1="Deze pagina is verhuisd" lead="De aanpak in 100 of 200 dagen vindt u nu onder Aanbod, bij Projecten versnellen." />
  <section class="band">
    <div class="wrap btn-row">
      <a class="btn btn-primary" href={naar}>Naar Projecten versnellen</a>
      <a class="btn btn-secondary" href="/aanbod">Bekijk het hele aanbod</a>
    </div>
  </section>
</Base>

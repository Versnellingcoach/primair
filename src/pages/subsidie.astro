---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import ExtLink from "../components/ExtLink.astro";
import VideoOfBeeld from "../components/VideoOfBeeld.astro";
import CtaBand from "../components/CtaBand.astro";
import { site, mail, videoSchema } from "../data/site";
import regelingen from "../data/regelingen.json";

type Regeling = {
  naam: string; organisatie?: string; provincie?: string; id?: string; wat?: string; voorWie: string;
  begeleiding: "ja" | "beperkt" | "nee"; begeleidingTekst: string; status: string; url: string; brabantRoute?: boolean; vraagProvincie?: boolean;
};
const landelijk = regelingen.landelijk as Regeling[];
const provinciaal = regelingen.provinciaal as Regeling[];
const labels = { ja: "Ja", beperkt: "Beperkt", nee: "Nee" } as const;
const vraagMail = mail("Welke regeling past bij ons project?", "Beste Versnellingscoach,\n\nWij willen graag weten welke ondersteuning past bij ons project of onze organisatie.\n\nOrganisatie en provincie:\nProject of vraag:\nTelefoonnummer:\n");
---
<Base title="Subsidie en ondersteuning voor versnelling" crumb="Subsidie en ondersteuning" schema={videoSchema("blossem")}
  description="Landelijke en provinciale regelingen en kennisbronnen voor versnelling van woningbouw, met per regeling of begeleiding of expertise in aanmerking komt.">
  <PageHead crumb="Subsidie en ondersteuning" h1="Subsidie en ondersteuning voor versnelling" lead="Rijk en provincies bieden regelingen, capaciteit en kennis om woningbouw te versnellen. Per regeling ziet u voor wie die is, wat de status is en of die de inzet van begeleiding of expertise kan ondersteunen." />

  <section class="band" aria-label="Snel naar">
    <div class="wrap stack">
      <nav class="subnav" aria-label="Onderdelen van deze pagina">
        <a class="link-cta" href="#landelijk">Landelijke mogelijkheden</a>
        <a class="link-cta" href="#provinciaal">Provinciale regelingen</a>
        <a class="link-cta" href="#kennis">Kennis en praktijkondersteuning</a>
      </nav>
      <p class="small muted">Voorwaarden, budget en openstelling veranderen regelmatig. Wij geven geen garantie op toekenning of vergoeding. Controleer altijd de actuele informatie bij de officiële bron. Laatst gecontroleerd: {regelingen.gecontroleerd}.</p>
    </div>
  </section>

  <section class="band sand" id="landelijk" aria-labelledby="landelijk-titel">
    <div class="wrap stack-lg">
      <div class="sectie-kop">
        <p class="eyebrow">Rijk en RVO</p>
        <h2 id="landelijk-titel">Landelijke financierings- en ondersteuningsmogelijkheden</h2>
      </div>
      <div class="regelingen">
        {landelijk.map((r) => (
          <article class="regeling">
            <h3>{r.naam}</h3>
            {r.organisatie && <p class="regeling-org">{r.organisatie}</p>}
            {r.wat && <p>{r.wat}</p>}
            <dl>
              <div><dt>Voor wie</dt><dd>{r.voorWie}</dd></div>
              <div><dt>Begeleiding of expertise</dt><dd><span class={`label-begeleiding label-${r.begeleiding}`}>{labels[r.begeleiding]}</span>{r.begeleidingTekst}</dd></div>
              <div><dt>Status</dt><dd>{r.status}</dd></div>
            </dl>
            <ExtLink href={r.url}>Officiële informatie</ExtLink>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band" id="provinciaal" aria-labelledby="provinciaal-titel">
    <div class="wrap stack-lg">
      <div class="sectie-kop">
        <p class="eyebrow">Provincies</p>
        <h2 id="provinciaal-titel">Provinciale regelingen</h2>
        <p>{regelingen.provinciaalIntro}</p>
      </div>
      <div class="regelingen">
        {provinciaal.map((r) => (
          <article class="regeling" id={r.id}>
            <p class="eyebrow">{r.provincie}</p>
            <h3>{r.naam}</h3>
            <dl>
              <div><dt>Voor wie</dt><dd>{r.voorWie}</dd></div>
              <div><dt>Begeleiding of expertise</dt><dd><span class={`label-begeleiding label-${r.begeleiding}`}>{labels[r.begeleiding]}</span>{r.begeleidingTekst}</dd></div>
              <div><dt>Status</dt><dd>{r.status}</dd></div>
            </dl>
            {r.brabantRoute && (
              <div class="stack-s note">
                <p><strong>Regionale Versnellingscoach.</strong> Volgens de provinciale flyer kan een Woondealregio tijdelijk een Versnellingscoach aanstellen. Uw Woondealregio stemt dit af met de provincie; per gemeente kan maximaal één project worden aangemeld. Aanspreekpunt bij de provincie is Christel Tax-Gloudemans, adviseur Ruimte en Wonen.</p>
                <ExtLink href={site.links.flyer} class="link-cta self-start">Bekijk de provinciale flyer</ExtLink>
              </div>
            )}
            <ExtLink href={r.url}>{r.vraagProvincie ? "Naar het woningbouwloket van de provincie" : "Officiële regeling"}</ExtLink>
          </article>
        ))}
      </div>
      <p class="small">Twijfelt u wat er in uw provincie mogelijk is? Vraag het uw provincie, of <a href={mail("Ondersteuning in onze provincie")}>vraag het ons</a>, dan zoeken we het met u uit.</p>
    </div>
  </section>

  <section class="band sand" id="kennis" aria-labelledby="kennis-titel">
    <div class="wrap stack-lg">
      <div class="sectie-kop">
        <p class="eyebrow">Kennis</p>
        <h2 id="kennis-titel">Kennis en praktijkondersteuning</h2>
        <p>Deze organisaties bundelen kennis, werkwijzen en praktijkvoorbeelden. Het zijn geen subsidieregelingen.</p>
      </div>
      <div class="regelingen">
        {regelingen.kennis.map((k) => (
          <article class="regeling">
            <h3>{k.naam}</h3>
            <p class="regeling-org">{k.organisatie}</p>
            <p>{k.wat}</p>
            <ExtLink href={k.url}>Naar de website</ExtLink>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band dark" aria-labelledby="bouwplaats">
    <div class="wrap grid-2">
      <div class="stack">
        <p class="eyebrow">Van de bouwplaats</p>
        <h2 id="bouwplaats">Zo brengt een Versnellingscoach woningbouw in beweging</h2>
        <p>De Provincie Noord-Brabant startte een pilot met regionale Versnellingscoaches. Op de bouwplaats van Blossem in Breda laat Marleen zien hoe een onafhankelijke procesregisseur gemeente, ontwikkelaar en woningcorporatie samen laat werken. In Brabant Magazine vertellen ook betrokkenen bij Wouwse Weide, Rucphen Noordwest en Zevenbergen Noord wat de aanpak opleverde.</p>
        <div class="btn-row mt">
          <ExtLink href={site.links.magazine} class="btn btn-primary">Lees de interviews</ExtLink>
          <a class="btn btn-secondary" href="/cases">Bekijk de cases</a>
        </div>
      </div>
      <div class="stack media-small">
        <VideoOfBeeld />
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="meedenken">
    <div class="wrap stack measure">
      <h2 id="meedenken" class="h-small">Twijfelt u welke regeling past?</h2>
      <p>We denken mee over de inzet van een Versnellingscoach en over wat u bij uw regio, provincie of het Rijk kunt aanvragen.</p>
      <a class="link-cta self-start" href={vraagMail}>Leg uw vraag aan ons voor</a>
    </div>
  </section>

  <CtaBand />
</Base>
